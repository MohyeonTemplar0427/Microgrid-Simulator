  "capacity_transmission": "GSA includes energy, capacity, ancillary services, losses and AEPS. TSC separately recovers default-supply network transmission. NBT is embedded distribution. No additional wholesale LMP/PLC/NSPL charge.",
  "rate_coverage": "2025-01-01 through2026-10-19, reviewed2026-10-19. Regular26\u201335-day cycles; only DSIC crossings supported (bills-rendered basis). Other applicable component crossings and partial/extended cycles reject.",
  "distribution_derivation": {
    "R_fixed_base": 11.25,
    "R_variable_base": 0.09465,
    "GS_demand_base": 10.63,
    "basis": "Strip the explicitly included Jan2025 ICUS/FARS/NDCA/USFC/NBT/EEPC and consumer education from printed R and GS rates; recompose dated riders once. Jun2025 R .09655 and GS11.34 independently agree. Dec2025 NBT changes recompose R .09649 and GS11.24; Jan2026 clean-up agrees after removing ending ICUS/FARS and changing USFC. Jan2026 rates are NOT applied to2025."
  },
  "2026_changes": {
    "January": "USFC .00287/kWh; ICUS/FARS0; STAS credit .04%; R .10276/kWh and fixed11.30; GS11.50/kW",
    "April": "R consumer education .04/month (fixed11.29); DSIC .11%",
    "June": "GSA R .10785/GS .10728; TOU R(.31430,.05767,.08362), GS(.26264,.06010,.08835) peak/super-off/off; TSC R .00974, GS2.20; NBT R .00322, GS .85; EEPC R .00232, GS .00121; R distribution .10246 and GS11.48/kW",
    "July": "ICUS R -.00009; FARS R -.00001; R distribution .10236; GS unchanged; DSIC .42%",
    "October": "R/GS ICUS/FARS unchanged; DSIC1.05%"
  },
