# Required for all carbon-intensity retrieval.
ELECTRICITY_MAPS_API_KEY=your_api_key_here

# Required for the gridstatus_io market provider
# (region: pjm_western_hub_gridstatus), which reaches PJM and other ISOs
# through the GridStatus.io hosted API. Self-serve signup; the free tier is
# metered at 500,000 rows per month.
# Key from https://www.gridstatus.io/settings/api
GRIDSTATUS_API_KEY=your_gridstatus_api_key_here

# Required only for the pjm provider (region: pjm_western_hub), which calls
# PJM's own Data Miner 2 API. Non-member accounts must first email PJM to
# confirm internal-use-only before a key is issued.
# Register at https://dataminer2.pjm.com/
PJM_API_KEY=your_pjm_api_key_here

# Required only for fetching satellite irradiance from NREL's NSRDB
# (src/profiles/nsrdb.py). Both values are needed together: the API requires a
# developer key and the address that key was registered to, which it uses to
# send notices about a request. Without them the weather path still works
# fully offline — supply a CSV through load_weather_csv instead.
# Register at https://developer.nrel.gov/signup/
NSRDB_API_KEY=your_nsrdb_api_key_here
NSRDB_API_EMAIL=the_address_your_nsrdb_key_is_registered_to

# Required only for the database layer (src/database/connector.py), which
# stores simulation runs, measurements, and power-flow results. All five are
# read with os.environ and have no defaults, so a missing one raises rather
# than connecting to something unintended. Create the schema first with
# sql/schema.sql; sql/seed.sql loads reference rows.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=your_database
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password

# The caiso and ercot providers need no credentials.
