# Configuration reference ONLY. Do not put real secrets in this tracked file.
# Set these in private process configuration; do not source unknown env files.
MICROGRID_PUBLIC_ORIGIN=https://microgrid.example.com
MICROGRID_SITE_ADDRESS=https://microgrid.example.com
MICROGRID_AUTH_MODE=oidc
MICROGRID_OIDC_ISSUER=https://YOUR_IDENTITY_PROVIDER/
MICROGRID_OIDC_CLIENT_ID=YOUR_CLIENT_ID
MICROGRID_OIDC_CLIENT_SECRET=
MICROGRID_OIDC_REDIRECT_URI=https://microgrid.example.com/auth/callback
# Queue controls, read by the API. Count includes queued, running and cancelling studies.
MICROGRID_MAX_PENDING_STUDIES=20
MICROGRID_MAX_PENDING_PER_USER=3
# Provisional accepted-simulation limit per signed-in user, resetting at 00:00 UTC.
MICROGRID_DAILY_STUDY_LIMIT=200
# Optional --allow-guests mode: conservative temporary-study limits.
MICROGRID_GUEST_DAILY_STUDY_LIMIT=2
MICROGRID_GUEST_GLOBAL_DAILY_LIMIT=20
MICROGRID_GUEST_DAILY_SESSION_LIMIT=100
MICROGRID_GUEST_DAILY_INTERACTION_LIMIT=20
MICROGRID_GUEST_GLOBAL_DAILY_INTERACTION_LIMIT=100
MICROGRID_TEMP_RESULT_HOURS=24
# Provisional CSV upload caps (bytes). These do not limit simulation results or weather files.
MICROGRID_MAX_UPLOAD_BYTES=16777216
MICROGRID_MAX_OWNER_DATASET_BYTES=104857600
MICROGRID_MAX_DATASET_STORE_BYTES=1073741824
# Provisional result/weather limits. Set identically for the API and worker.
MICROGRID_MAX_RUN_BYTES=2147483648
MICROGRID_MAX_OWNER_RUN_BYTES=8589934592
MICROGRID_MAX_RUN_STORE_BYTES=34359738368
MICROGRID_MAX_WEATHER_BYTES=67108864
MICROGRID_MAX_OWNER_WEATHER_BYTES=268435456
MICROGRID_MAX_WEATHER_STORE_BYTES=2147483648
MICROGRID_MIN_FREE_BYTES=2147483648
# Server-side data-provider keys remain optional according to the selected study.
NSRDB_API_KEY=
NSRDB_API_EMAIL=
ELECTRICITY_MAPS_API_KEY=
