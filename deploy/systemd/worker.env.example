# Copy privately to /etc/microgrid/worker.env (root:microgrid, mode 0640).
# No OIDC client secret belongs in the worker environment.
MICROGRID_MAX_PENDING_STUDIES=20
MICROGRID_MAX_PENDING_PER_USER=3
MICROGRID_DAILY_STUDY_LIMIT=200
MICROGRID_GUEST_DAILY_STUDY_LIMIT=2
MICROGRID_GUEST_GLOBAL_DAILY_LIMIT=20
MICROGRID_GUEST_DAILY_SESSION_LIMIT=100
MICROGRID_GUEST_DAILY_INTERACTION_LIMIT=20
MICROGRID_GUEST_GLOBAL_DAILY_INTERACTION_LIMIT=100
MICROGRID_TEMP_RESULT_HOURS=24
MICROGRID_MAX_UPLOAD_BYTES=16777216
MICROGRID_MAX_OWNER_DATASET_BYTES=104857600
MICROGRID_MAX_DATASET_STORE_BYTES=1073741824
MICROGRID_MAX_RUN_BYTES=2147483648
MICROGRID_MAX_OWNER_RUN_BYTES=8589934592
MICROGRID_MAX_RUN_STORE_BYTES=34359738368
MICROGRID_MAX_WEATHER_BYTES=67108864
MICROGRID_MAX_OWNER_WEATHER_BYTES=268435456
MICROGRID_MAX_WEATHER_STORE_BYTES=2147483648
MICROGRID_MIN_FREE_BYTES=2147483648
# Configure only if studies requiring historical carbon data are offered.
ELECTRICITY_MAPS_API_KEY=
