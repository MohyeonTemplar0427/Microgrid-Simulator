[Unit]
Description=Microgrid Simulator independent study worker
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/microgrid

[Service]
Type=simple
User=microgrid
Group=microgrid
WorkingDirectory=/opt/microgrid/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/microgrid
Environment=MPLCONFIGDIR=/var/lib/microgrid/matplotlib
EnvironmentFile=/etc/microgrid/worker.env
ExecStart=/opt/microgrid/venv/bin/python -m src.local_web.runner --data-dir /var/lib/microgrid/studies
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/microgrid

[Install]
WantedBy=multi-user.target
